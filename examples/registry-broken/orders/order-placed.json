{
  "name": "orders.order_placed",
  "owner": "team-orders",
  "description": "The same event as the clean registry, with a version 2 that breaks its consumers.",
  "producers": [
    "checkout-api"
  ],
  "consumers": [
    "billing-worker",
    "search-indexer"
  ],
  "versions": [
    {
      "version": 1,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id",
          "total_minor",
          "currency"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "total_minor": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code."
          }
        }
      }
    },
    {
      "version": 2,
      "description": "Drops currency and narrows the total, both of which consumers of v1 depend on.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id",
          "total_minor"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "total_minor": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
